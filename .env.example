# ============================================================
# Bu yerda faqat BOSHLANG'ICH maxfiy qiymatlar.
# Qolgan BARCHA sozlamalar admin panelda (http://localhost:7860).
# Hugging Face'da bularni Space -> Settings -> Secrets ga yozing.
# ============================================================

# Admin panel login va parol (parol kamida 12 belgi tavsiya etiladi)
ADMIN_USERNAME=abu
ADMIN_PASSWORD=

# Shifrlash kaliti: uzun tasodifiy satr. O'ZGARTIRMANG - aks holda zaxira ochilmaydi.
# Yaratish: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Hugging Face'da sessiya va sozlamalar restartdan keyin yo'qolmasligi uchun
# (shifrlangan holda private dataset'ga saqlanadi). Token "write" huquqli bo'lsin.
HF_TOKEN=
STATE_REPO=ABDULHODIY/tg-autoreply-state

# Ixtiyoriy: birinchi ishga tushishda panelga avtomatik yoziladigan qiymatlar
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# OPENROUTER_API_KEYS=sk-or-v1-aaa,sk-or-v1-bbb
# TELEGRAM_STRING_SESSION=

# DATA_DIR=data
# PORT=7860
# LOG_LEVEL=INFO
